# Set default behavior to automatically normalize line endings
* text=auto

# Force files to use LF (Unix) line endings
*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Exclude repository-specific configuration and documentation from Composer distribution packages
/.github/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/AGENTS_RU.md export-ignore
/LICENSE export-ignore
